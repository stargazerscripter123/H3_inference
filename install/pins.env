# =============================================================================
# pins.env — 本部署的唯一版本真相。所有装机脚本 source 它,不要在别处再写一份。
#
# 这是什么
#   MiniMax-H3 FL2VA(首帧+尾帧 -> 带原生音频的视频)在 2x RTX 5090 单机上的
#   ComfyUI 产线,三个 profile:
#     comfy-int8-original-1c   30 步基线,零 tweak,GPU1:8188,     ~110s
#     comfy-int8-teacache-1c   12 步 + TeaCache,   GPU0:8189,     ~35s
#     comfy-int8-turbo-1c      4~6 步 + Turbo LoRA,GPU0:8190,     ~25s (NFE4)
#   延迟口径:864x480 / 124 帧(5.17s)/ 带音频 / warm。冷启首推约慢一倍。
#
#   本仓库不含权重(最小集 40.28 GiB),用 install/download_models.sh 获取。
#
# 这份文件为什么存在(没有 README,说明都在脚本注释里)
#   H3 这条链路上"版本对不上"不会报错,只会静默退化或静默出错:
#     - ComfyUI 升级会改变 Turbo 节点走的采样路径(见 COMFYUI_COMMIT 段)
#     - 权重按字节校验分辨不了 fl2va 与 ref2va(两者字节数完全相同),必须 sha256
#     - LoRA 用错节点会加载 0/518 个张量而不报任何错(见 scripts/run_fl2va.py)
#   所以这里的每个 pin 都带"为什么是它"。改 pin 之前先读那段理由。
#
# 与上游主仓库的关系
#   本分支从 github.com/stargazerscripter123/H3_inference 的最小化需求切出,
#   是 orphan 分支:与 main 没有共同祖先,不能 merge / cherry-pick。
#   main 上的 scripts/run_fl2va.py 若有修复,只能手工 patch 过来。
# =============================================================================

# --- 项目根 ------------------------------------------------------------------
# 所有脚本的路径都相对它。默认取本文件所在仓库的上级目录,可用环境变量覆盖。
#
# 必须 export:h3.sh 会以子进程调 comfyctl.sh / prep_frames.sh,doctor.sh 会调
# download_models.sh,子进程会各自重新 source 本文件。不 export 的话覆盖值在子进程
# 里丢失,子进程会退回按自己的位置推 —— 于是父子看到的项目根不一样。
H3_BASE="${H3_BASE:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export H3_BASE

# --- conda 环境 --------------------------------------------------------------
# 环境本体在仓库外(~/miniconda3/envs/)。仓库里有两份锁,分工不同:
#   requirements.lock.txt  ★ 权威,也是唯一被执行的那份(107 个包全是 pip 装的,
#                            conda 在这个环境里只管 python/pip/openssl)
#   environment.yml          conda 侧快照,**故意不用它建环境** —— 它的 conda 依赖
#                            带 defaults 频道的 build string,换机器/换日期未必解析
#                            得出;pip: 段又与上面那份重复。用途是 diff 现状与采集日。
H3_CONDA_ENV="${H3_CONDA_ENV:-h3_comfy_NV_py312}"
H3_CONDA_ROOT="${H3_CONDA_ROOT:-$HOME/miniconda3}"
H3_PYTHON="${H3_PYTHON:-$H3_CONDA_ROOT/envs/$H3_CONDA_ENV/bin/python}"
H3_PY_VERSION="3.12.13"
export H3_CONDA_ENV H3_CONDA_ROOT H3_PYTHON

# torch 2.11.0+cu130 —— cu13 系列 wheel,不是 cu12。
# 这台机器驱动 580.173.02 报告 CUDA 13.0,且系统里没有 nvcc:整个 CUDA 运行时
# 都来自 pip 的 nvidia-*-cu13 wheel。换驱动就要重新选 wheel 变体。
H3_TORCH="2.11.0+cu130"
H3_TORCHVISION="0.26.0+cu130"
H3_TORCHAUDIO="2.11.0+cu130"
H3_TORCH_INDEX="https://download.pytorch.org/whl/cu130"

# --- ComfyUI -----------------------------------------------------------------
# 钉在 v0.29.0 的 57500fc,也就是 "feat: Support MiniMax-H3 (CORE-375) (#15224)"
# 那个 commit —— H3 官方支持刚落地的位置。
#
# 为什么必须钉死:这个版本还没有原生的 ModelSamplingAV,Turbo 节点会回落到它自带的
# legacy dual-schedule(video shift 12 / audio shift 3),worker 日志里能看到
#   [H3TURBO sampler] legacy dual-schedule (no native ModelSamplingAV)
#   sigmas=[1.0, 0.973, 0.9231, 0.8, 0.0]
# 升级 ComfyUI 会让这条路径切到原生实现,**输出会变**。要升就得重新跑全部对比。
COMFYUI_REPO="https://github.com/comfyanonymous/ComfyUI.git"
COMFYUI_COMMIT="57500fc5bc92566a63f2046824f522cd55c335ca"
COMFYUI_VERSION="0.29.0"

# --- custom_nodes ------------------------------------------------------------
# 三个都是 detached checkout,三个都零 pip 依赖(只装 ComfyUI 本体的 requirements)。
#
# Turbo:提供 MiniMaxH3TurboLoRA + MiniMaxH3TurboSampler。**Turbo LoRA 必须走它**,
#   ComfyUI 核心的 LoraLoaderModelOnly 对 H3 是静默 no-op,详见 run_fl2va.py。
#   仓库内自带两个二进制资产(h3_silu_temb_grid.safetensors 5.5MB、node.zip),
#   git clone 会带下来;换成打包分发就会漏,所以 bootstrap.sh 装完要验它们在。
NODE_TURBO_REPO="https://github.com/Larryvrh/ComfyUI-MiniMax-H3-Turbo"
NODE_TURBO_COMMIT="55fee864dd7b2976b1c4ce3c3d5f7968f181409f"
NODE_TURBO_ASSET="h3_silu_temb_grid.safetensors"

# TeaCache:提供 MiniMaxH3TeaCache,comfy-int8-teacache-1c 用。
NODE_TEACACHE_REPO="https://github.com/Icyoung/ComfyUI-MiniMaxH3-TeaCache.git"
NODE_TEACACHE_COMMIT="4cbb50d69c73a19a5d6ec42c5aec1989d5a04b6f"

# MultiGPU:**三个 profile 都不用它的节点,但它必须装**。
#   它一加载就 monkey-patch model_management(设备选择/显存核算),本部署记录的
#   全部延迟数字都是在它在场的前提下测的。不装 -> 数字不可比。
NODE_MULTIGPU_REPO="https://github.com/pollockjj/ComfyUI-MultiGPU.git"
NODE_MULTIGPU_COMMIT="b51c99a525e9607e43545ee2a8b7694c74a4775a"

# --- 权重 --------------------------------------------------------------------
# 最小集 40.28 GiB,三个 profile 共用。不需要 fp8 DiT 与 int8 TE(那是 serving 线的)。
#
# 为什么要 sha256 而不是只看字节数:同一个 repo 里 minimax_h3_ref2va_* 系列与
# fl2va 系列**字节数完全相同**。下错了不会报错,只会生成得莫名其妙。
HF_COMFY_REPO="Comfy-Org/MiniMax-H3"
HF_COMFY_REV="014cd40f7e177756c6b2473c0d93b1c89a790dd2"

HF_LORA_REPO="larryvrh/MiniMax-H3-Turbo-Lora"
HF_LORA_REV="afc0346516372a17162c14df3c5264de1d9aa1c0"

# 格式: <hf_repo_key>|<repo 内路径>|<落地相对 H3_BASE 的路径>|<bytes>|<sha256>
# hf_repo_key: comfy = HF_COMFY_REPO@HF_COMFY_REV, lora = HF_LORA_REPO@HF_LORA_REV
H3_WEIGHTS=(
"comfy|diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors|ComfyUI/models/diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors|20970379616|e889202c41dafb67b10d67b97f0d8541508036a6090af23425a5c2615d03c47a"
"comfy|text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors|ComfyUI/models/text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors|15687142551|35a88d51044231fe332301d7a62aa81e3f2cba62febeb446e2c1e3e0ef76f2c6"
"comfy|vae/minimax_h3_video_vae_fp16.safetensors|ComfyUI/models/vae/minimax_h3_video_vae_fp16.safetensors|5207808496|7c1f131492e7eddacaac9069a61b81bdd39de5cc96561e677c5eab1cdce5e522"
"comfy|vae/minimax_h3_audio_vae_fp32.safetensors|ComfyUI/models/vae/minimax_h3_audio_vae_fp32.safetensors|605254808|8e505d95dd1561d47abd43d4238fd40d9bb1ae9e147ed0a4cba778d76ae4db48"
"lora|minimax_h3_turbo_v4_step600_ema.safetensors|loras/minimax_h3_turbo_v4_step600_ema.safetensors|779849816|5f3a626cd72c93a8b9318d6760c510bc5092d2ab13aaba1f932c5bab07a416d3"
)

# LoRA 实体扁平放在 $H3_BASE/loras/,ComfyUI 侧靠 models/loras/ 下的**符号链接**看到它。
# (别照抄别处写的 loras/MiniMax-H3-Turbo-Lora/<file> 那种带子目录的布局。)
H3_LORA_LINK="ComfyUI/models/loras/minimax_h3_turbo_v4_step600_ema.safetensors"

# --- 硬件前提(bootstrap/doctor 用来自检) --------------------------------------
# 采集自实机: Ubuntu 24.04.4 LTS / 内核 7.0.0-28 / 驱动 580.173.02 / CUDA 13.0
# 2x RTX 5090 (32607 MiB each) / RAM 125 GiB / ffmpeg 6.1.1
H3_MIN_DRIVER="580"          # 低于它 cu130 wheel 跑不起来
H3_MIN_VRAM_MIB="30000"      # 单卡至少 ~30G,int8 DiT 常驻约 20G + TE/VAE
H3_MIN_RAM_GIB="100"         # 单个 worker 实测 RSS 46.4 GiB
H3_MIN_DISK_GIB="60"         # 权重 40.3G + ComfyUI/env/产物余量
