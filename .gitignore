models/
models_*/
base/
merged/
loras/
h3_weights/
src/
src-*/
ComfyUI/
env/
venv/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf

# ── 运行时状态与产物 ─────────────────────────────────────────────
