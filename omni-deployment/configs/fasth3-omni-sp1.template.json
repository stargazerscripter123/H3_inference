{
  "generator": {
    "model_path": "${OMNI_MODEL_DIR}",
    "engine": {
      "num_gpus": 1,
      "execution_backend": "mp",
      "use_fsdp_inference": false,
      "quantization": {
        "transformer_quant": "NVFP4",
        "layer_profile": "h3_dit_vsa"
      },
      "parallelism": {
        "tp_size": 1,
        "sp_size": 1,
        "dist_timeout": 600
      },
      "offload": {
        "dit": false,
        "dit_layerwise": false,
        "text_encoder": true,
        "vae": false,
        "pin_cpu_memory": true,
        "lazy_module_load": false
      },
      "compile": {
        "enabled": false
      }
    },
    "pipeline": {
      "workload_type": "i2v",
      "vae_tiling": true,
      "components": {
        "override_pipeline_cls_name": "MiniMaxH3Ref2VAModularPipeline"
      },
      "experimental": {
        "attention_backend": "VIDEO_SPARSE_ATTN_H3",
        "h3_vsa_fp4": {
          "enabled": true,
          "prefix_precision": "fp8",
          "two_level_p": true,
          "smooth_k": true
        },
        "video_decode_backend": "h3-vae",
        "h3_sequential_load": true,
        "h3_vae_nvfp4_decoder": "${OMNI_DECODER}"
      }
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8108,
    "output_dir": "${OMNI_OUTPUT_DIR}",
    "served_model_name": "fasth3-omni-qad-sp1",
    "media_roots": [
      "${OMNI_INPUT_DIR}"
    ],
    "allow_private_media_urls": false,
    "media_reference_max_bytes": 2147483648
  },
  "default_request": {
    "negative_prompt": "",
    "sampling": {
      "height": 480,
      "width": 832,
      "num_frames": 362,
      "fps": 24,
      "num_inference_steps": 8,
      "guidance_scale": 1,
      "batch_cfg": false,
      "seed": 1234
    },
    "output": {
      "return_frames": false
    }
  }
}
